{
  "name": "azelf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "lab:doctor": "tsx scripts/doctor.ts",
    "lab:typecheck": "tsc --noEmit",
    "lab:test:unit": "vitest run",
    "lab:test:integration": "vitest run evaluation/contracts/adapter.test.ts",
    "lab:test:acceptance": "playwright test",
    "lab:dev": "tsx scripts/lab.ts",
    "lab:stop": "tsx scripts/stop.ts",
    "lab:test:policy": "vitest run evaluation/contracts/policy.test.ts",
    "lab:test:scenarios": "tsx scripts/scenarios.ts",
    "lab:test:isolation": "tsx scripts/isolation.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "zod": "4.1.12"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
